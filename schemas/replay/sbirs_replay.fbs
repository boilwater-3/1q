// sbirs_replay.fbs
// SBIRS-inspired replay FlatBuffers schema: cycle_input and cycle_output payloads.

namespace sbirs.replay;

struct Vec3d {
  x: double;
  y: double;
  z: double;
}

table SbirsSceneTarget {
  target_id: uint64;
  target_name: string;
  position_ecef_m: Vec3d;
  temperature_k: float;
  emissivity: float;
  projected_area_m2: float;
  velocity_ecef_m_per_s: Vec3d;
  has_velocity_ecef_m_per_s: bool;
  active: bool;
}

table SbirsCycleInput {
  cycle_index: uint32;
  dt_sec: float;
  has_satellite_position: bool;
  satellite_position_ecef_m: Vec3d;
  scene_targets: [SbirsSceneTarget];
}

root_type SbirsCycleInput;
file_identifier "SBIC";

table SbirsDetectionRecord {
  detection_id: uint64;
  azimuth_deg: float;
  elevation_deg: float;
  infrared_snr_linear: float;
  observation_stage: int32;
  detected: bool;
}

table SbirsDetectionAttributionRecord {
  detection_id: uint64;
  target_id: uint64;
  target_name: string;
  estimated_range_m: float;
  tracking_source: int32;
  capture_failure_reason: int32;
  has_estimation_nis: bool;
  estimation_nis: float;
  estimation_nis_gate_exceeded: bool;
  nfov_channel_id: int32;
  has_nfov_tracking_diagnostics: bool;
  nfov_pointing_error_deg: float;
  nfov_geometry_gate_passed: bool;
  nfov_snr_gate_passed: bool;
  nfov_tracking_gate_failure_count: uint32;
  nfov_tracking_coasting: bool;
}

table SbirsOutputFrame {
  cycle_index: uint32;
  scan_azimuth_deg: float;
  detections: [SbirsDetectionRecord];
}

// 统一问题列表模型（session_contract.md 规则 14）：单一 SbirsIssue 列表承载
// 输入校验问题（phase=kInputValidation）与执行诊断（phase=kExecution）。

table SbirsIssue {
  severity:      int32;
  phase:         int32;
  code:          string;
  message:       string;
  location_kind: int32 = 0;
  entity_index:  int64 = -1;
  field:         string;
}

table SbirsCycleResult {
  input_cycle_index: uint32;
  output_frame: SbirsOutputFrame;
  detection_attributions: [SbirsDetectionAttributionRecord];
  executed_this_cycle: bool;
  abort_reason: int32;
  status: uint8;
  issues: [SbirsIssue];
}

table FailureMarker {
  error_code: string;
  message: string;
  location: string;
  has_cycle_index: bool;
  cycle_index: uint32;
  has_sim_time_sec: bool;
  sim_time_sec: double;
  diagnostics: string;
  has_last_event_sequence: bool;
  last_event_sequence: uint64;
}
