// sar_replay.fbs
// SAR 模块 replay FlatBuffers schema：cycle_input 与 cycle_output 载荷。
//
// file_identifier: SARC (SAR Cycle)

namespace sar.replay;

table SarPlatformState {
  time_s: double;
  latitude_deg: double;
  longitude_deg: double;
  altitude_m: double;
  velocity_north_mps: double;
  velocity_east_mps: double;
  velocity_down_mps: double;
  roll_deg: double;
  pitch_deg: double;
  yaw_deg: double;
}

table SarPointTarget {
  latitude_deg: double;
  longitude_deg: double;
  altitude_m: double;
  radar_cross_section_dbsm: double;
  target_id: uint64;
  target_name: string;
}

table SarRawIqPulseState {
  pulse_id: uint64;
  time_s: double;
  position_x_m: double;
  position_y_m: double;
  position_z_m: double;
  velocity_x_mps: double;
  velocity_y_mps: double;
  velocity_z_mps: double;
}

table SarRawIqFrame {
  samples_per_pulse: uint32;
  i_values: [double];
  q_values: [double];
  pulse_states: [SarRawIqPulseState];
  ideal_pulse_states: [SarRawIqPulseState];
}

table SarCycleInput {
  cycle_index: uint32;
  dt_sec: float;
  platform: SarPlatformState;
  point_targets: [SarPointTarget];
  raw_iq: SarRawIqFrame;
}

root_type SarCycleInput;
file_identifier "SARC";

table SarOutputFrame {
  cycle_index: uint32;
  completed_stage: int32;
  range_sample_count: uint32;
  azimuth_pulse_count: uint32;
  center_slant_range_m: double;
  estimated_snr_db: double;
  phase_reference_mode: int32;
  image_quality_mainlobe_method: int32;
  range_width_3db_bins: double;
  azimuth_width_3db_bins: double;
  range_resolution_3db_m: double;
  azimuth_resolution_3db_m: double;
  image_entropy_nats: double;
  image_contrast: double;
  has_raw_echo: bool;
  has_range_compressed_echo: bool;
  has_l1_image: bool;
  has_l3_bp_image: bool;
  has_image_quality_metrics: bool;
  image_resolution_m_valid: bool;
  phase_reference_applied: bool;
}

table SarDiagnosticIssue {
  severity: int32;
  code: string;
  message: string;
}

table SarRawPhaseHistory {
  source: int32;
  pulse_count: uint32;
  samples_per_pulse: uint32;
  i_values: [double];
  q_values: [double];
}

table SarFocusedImage {
  source: int32;
  row_count: uint32;
  column_count: uint32;
  real_values: [double];
  imaginary_values: [double];
  is_placeholder: bool;
}

table SarCycleResult {
  input_cycle_index: uint32;
  output_frame: SarOutputFrame;
  focused_image: SarFocusedImage;
  diagnostics: [SarDiagnosticIssue];
  raw_phase_history: SarRawPhaseHistory;
  has_error: bool;
  executed_this_cycle: bool;
  abort_reason: string;
}
