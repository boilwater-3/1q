// esr_replay.fbs
// ESR 模块 replay FlatBuffers schema：cycle_input 与 cycle_output 载荷
//
// file_identifier: ESRC (ESR Cycle)

namespace esr.replay;

// ---- 基础向量与姿态类型 ----

struct Vec3 {
  x: double;
  y: double;
  z: double;
}

struct EulerDeg {
  yaw_deg:   double;
  pitch_deg: double;
  roll_deg:  double;
}

table PoseState {
  position_m:   Vec3;
  velocity_mps: Vec3;
  attitude_deg: EulerDeg;
}

// ---- EsrCycleInput ----

table EmitterBeamState {
  center_az_deg:    double;
  center_el_deg:    double;
  az_beamwidth_deg: double;
  el_beamwidth_deg: double;
  beam_state_valid: bool;
}

table SceneEmitter {
  emitter_id:   uint64;
  pose:         PoseState;
  carrier_hz:   double;
  bandwidth_hz: double;
  tx_power_w:   double;
  pulse_width_s: double;
  pri_s:        double;
  beam_state:   EmitterBeamState;
  is_emitting:  bool;
  emitter_name: string;
  has_ecef_kinematics: bool = false;
  position_ecef_m: Vec3;
  velocity_ecef_mps: Vec3;
}

struct RfUnitVector {
  x: double;
  y: double;
  z: double;
}

table RfAntennaPattern {
  boresight_ecef_unit: RfUnitVector;
  peak_gain_dbi: double;
  half_power_beamwidth_deg: double;
  sidelobe_level_db: double;
  backlobe_level_db: double;
  cross_polarization_isolation_db: double;
}

table RfEmissionSegment {
  start_time_s: double;
  duration_s: double;
  center_frequency_hz: double;
  bandwidth_hz: double;
  transmit_power_w: double;
}

table RfEmission {
  emission_id: uint64;
  entity_id: uint64;
  position_ecef_m: Vec3;
  velocity_ecef_mps: Vec3;
  antenna: RfAntennaPattern;
  polarization: int32;
  waveform_kind: int32;
  segments: [RfEmissionSegment];
}

table EsrJammerSource {
  technique:       int32;
  active:          bool;
  center_hz:       double;
  bandwidth_hz:    double;
  power_w:         float;
  deception_risk:  float;
  confidence:      float;
}

table EsrAtmosphericObservation {
  relative_humidity_ratio:  float;
  precipitation_rate_mmph:  float;
  visibility_km:            float;
}

table EsrEnvironmentInput {
  propagation_profile:      int32;
  clutter_density:          int32;
  spectrum_occupancy_ratio: float;
  atmospheric_observation:  EsrAtmosphericObservation;
  jammer_sources:           [EsrJammerSource];
  // -1 means a pre-tagged legacy payload; decoder infers none/legacy from the old field.
  interference_mode:        int32 = -1;
  engineering_emissions:    [RfEmission];
}

table EsrCycleInput {
  cycle_index:             uint32;
  dt_sec:                  float;
  platform_pose:           PoseState;
  scene_emitters:          [SceneEmitter];
  environment:             EsrEnvironmentInput;
  platform_altitude_m:     float = 0.0;
  platform_entity_id:      uint64 = 0;
  has_platform_ecef_kinematics: bool = false;
  platform_position_ecef_m: Vec3;
  platform_velocity_ecef_mps: Vec3;
}

root_type EsrCycleInput;
file_identifier "ESRC";

// ---- EsrOutputFrame ----

table EmitterObservation {
  observation_id: uint64;
  timestamp_s:    double;
  aoa_az_deg:     double;
  aoa_el_deg:     double;
  rf_hz:          double;
  pulse_width_s:  double;
  amplitude_db:   double;
  snr_db:         double;
  quality:        int32;
  is_jammed:      bool;
  bandwidth_hz:   double;
  pri_s:          double;
  rf_std_hz:      double;
  bandwidth_std_hz: double;
  pri_std_s:      double;
  pulse_width_std_s: double;
}

table ObservationOutput {
  raw_observation_count: uint32;
  cluster_count:         uint32;
  observations:          [EmitterObservation];
  receiver_center_frequency_hz: double;
  receiver_bandwidth_hz: double;
  receiver_saturated: bool;
}

table EmitterHypothesis {
  hypothesis_id:     uint64;
  candidate_classes: [string];
  mode:              int32;
  threat_level:      int32;
  bearing_az_deg:    float;
  bearing_el_deg:    float;
  bearing_std_deg:   float;
  confidence:        float;
  last_seen_cycle:   uint32;
  estimated_center_frequency_hz: double;
  estimated_bandwidth_hz: double;
  estimated_pri_s: double;
  estimated_pulse_width_s: double;
  center_frequency_std_hz: double;
  bandwidth_std_hz: double;
  pri_std_s: double;
  pulse_width_std_s: double;
}

table EmitterOutput {
  hypotheses:   [EmitterHypothesis];
}

table TruthAssociationRecord {
  observation_id:   uint64;
  truth_emitter_id: uint64;
  matched:          bool;
  confidence:       float;
}

table TruthEvaluationOutput {
  associations:            [TruthAssociationRecord];
}

table EsrOutputFrame {
  cycle_index:           uint32;
  batch_id:              uint64;
  observation_output:    ObservationOutput;
  emitter_output:        EmitterOutput;
  truth_evaluation_output: TruthEvaluationOutput;
}

// ---- EsrCycleResult (cycle_output via StepWithResult) ----

table ValidationIssue {
  severity:      int32;
  code:          int32;
  emitter_index: int32;
  field:         string;
  message:       string;
}

table EsrCycleResult {
  input_cycle_index:    uint32;
  output_frame:         EsrOutputFrame;
  validation_issues:    [ValidationIssue];
  has_validation_error: bool;
  executed_this_cycle:  bool = false;
  reused_previous_output: bool = false;
  abort_reason:         int32 = 0;
}

// ---- FailureMarker (failure_marker 事件的 flatbuffer 载荷) ----
// 字段与 AR 模块的 FailureMarker 保持一致，用于在回放时结构化还原失败标记。

table FailureMarker {
  error_code:           string;
  message:              string;
  location:             string;
  has_cycle_index:      bool;
  cycle_index:          uint32;
  has_sim_time_sec:     bool;
  sim_time_sec:         double;
  diagnostics:          string;
  has_last_event_sequence: bool;
  last_event_sequence:  uint64;
}
