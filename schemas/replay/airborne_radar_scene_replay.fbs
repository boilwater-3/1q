namespace oneq.replay.airborne_radar.scene.fb;

table AtmosphericPhysicsConfig {
  enable_physical_model:bool;
  pressure_hpa:float;
  temperature_k:float;
  relative_humidity:float;
}

table AtmosphericDerivedContext {
  has_simulation_unix_seconds:bool;
  simulation_unix_seconds:long;
  solar_flux_f107a:float;
  solar_flux_f107:float;
  geomagnetic_ap:float;
}

table VegetationScatterPhysicsConfig {
  cover_profile:int;
  enable_physical_model:bool;
}

table JammerEmitterState {
  technique:int;
  power_db:float;
  js_db:float;
  has_direction_deg:bool;
  azimuth_deg:float;
  elevation_deg:float;
  angular_span_deg:float;
  confidence:float;
}

table EnvironmentSceneState {
  atmospheric_physics:AtmosphericPhysicsConfig;
  atmospheric_context:AtmosphericDerivedContext;
  vegetation_scatter_physics:VegetationScatterPhysicsConfig;
  jammer_emitters:[JammerEmitterState];
}

root_type EnvironmentSceneState;
file_identifier "ARSS";
