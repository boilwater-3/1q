// sbirs_session_replay.fbs
// SBIRS-inspired replay FlatBuffers schema: session_config and runtime patches.

namespace sbirs.replay;

table SbirsHardwareConfig {
  wavelength_lower_um: float;
  wavelength_upper_um: float;
  optical_aperture_m: float;
  detector_area_m2: float;
  optical_transmission: float;
  detector_quantum_efficiency: float;
  integration_time_sec: float;
  noise_equivalent_power_w: float;
  background_radiance_w_sr_m2: float;
  detector_temperature_k: float;
  readout_noise_rms_w: float;
}

table SbirsMissionConfig {
  work_mode: int32;
  power_on: bool;
  wide_field_fov_az_deg: float;
  wide_field_fov_el_deg: float;
  narrow_field_fov_az_deg: float;
  narrow_field_fov_el_deg: float;
  scan_start_az_deg: float;
  scan_end_az_deg: float;
  scan_center_el_deg: float;
  scan_rate_deg_per_sec: float;
  min_range_m: float;
  max_range_m: float;
  frame_rate_hz: float;
  narrow_cue_latency_s: float;
  narrow_pointing_settle_error_deg: float;
  narrow_pointing_max_slew_rate_deg_per_sec: float = 30.0;
  narrow_pointing_settle_tolerance_deg: float = 0.01;
}

table SbirsDetectionPolicyConfig {
  wide_min_snr_linear: float;
  narrow_min_snr_linear: float;
}

table SbirsErrorModelConfig {
  range_fraction_sigma: float;
  random_seed: uint32;
  orbit_sigma_deg: float;
  attitude_sigma_deg: float;
  fov_sigma_deg: float;
  detector_bandwidth_hz: float;
}

table SbirsPointingDisturbanceConfig {
  common_attitude_sigma_deg: float;
  common_attitude_correlation_time_s: float = 1.0;
  channel_pointing_sigma_deg: float;
  channel_pointing_correlation_time_s: float = 1.0;
  channel_vibration_amplitude_deg: float;
  channel_vibration_frequency_hz: float;
  random_seed: uint32 = 1;
}

table SbirsSchedulerConfig {
  max_concurrent_nfov_locks: int32;
}

table SbirsTrackingConfig {
  enable_estimated_tracking: bool;
  process_noise_diff_coeff: float;
  initial_position_std_m: float;
  initial_velocity_std_m_per_s: float;
  nis_gate_loss_cycles: uint32;
  nfov_tracking_gate_loss_cycles: uint32;
  enable_imm_tracking: bool;
  imm_model_noise_diff_coeffs: [float];
}

table SbirsPolicyConfig {
  detection: SbirsDetectionPolicyConfig;
  error_model: SbirsErrorModelConfig;
  pointing_disturbance: SbirsPointingDisturbanceConfig;
  scheduler: SbirsSchedulerConfig;
  tracking: SbirsTrackingConfig;
}

table SbirsEnvironmentConfig {
  weather_type: int32;
  sea_state: int32;
  temperature_c: float;
  relative_humidity_percent: float;
  visibility_km: float;
  base_atmospheric_transmittance: float;
  humidity_visibility_interaction_weight: float;
  rain_humidity_interaction_weight: float;
}

table SbirsSessionConfig {
  hardware: SbirsHardwareConfig;
  mission: SbirsMissionConfig;
  policy: SbirsPolicyConfig;
  environment: SbirsEnvironmentConfig;
}

root_type SbirsSessionConfig;
file_identifier "SBIS";

table SbirsRuntimeConfigPatch {
  has_mission: bool;
  mission: SbirsMissionConfig;
  has_policy: bool;
  policy: SbirsPolicyConfig;
  has_environment: bool;
  environment: SbirsEnvironmentConfig;
  has_work_mode: bool;
  work_mode: int32;
  has_scan_rate_deg_per_sec: bool;
  scan_rate_deg_per_sec: float;
  has_power_on: bool;
  power_on: bool;
}
