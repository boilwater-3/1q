// eos_replay.fbs
// EOS 模块 replay FlatBuffers schema：cycle_input 与 cycle_output 载荷
//
// file_identifier: EOSC (EOS Cycle)

namespace eos.replay;

// ---- 基础向量与姿态类型 ----

struct Vec3 {
  x: double;
  y: double;
  z: double;
}

struct EulerDeg {
  yaw_deg:   double;
  pitch_deg: double;
  roll_deg:  double;
}

table PoseState {
  position_m:   Vec3;
  velocity_mps: Vec3;
  attitude_deg: EulerDeg;
}

// ---- EosCycleInput ----

table EosTargetState {
  target_id:             uint64;
  range_m:               float;
  azimuth_deg:           float;
  elevation_deg:         float;
  apparent_temperature_k: float;
  emissivity:            float;
  reflectance:           float;
  projected_area_m2:     float;
  target_name:           string;
}

table EosEnvironmentInput {
  solar_altitude_deg:       float;
  solar_azimuth_deg:        float;
  solar_irradiance_w_m2:    float;
  cloud_coverage_ratio:     float;
  ambient_wind_speed_mps:   float;
  day_night_type:           int32;
  background_temperature_k: float;
}

table EosCycleInput {
  cycle_index:              uint32;
  dt_sec:                   float;
  platform_pose:            PoseState;
  environment:              EosEnvironmentInput;
  scene_targets:            [EosTargetState];
  platform_altitude_m:      float = 0.0;
}

root_type EosCycleInput;
file_identifier "EOSC";

// ---- EosOutputFrame ----

table EosDetectionRecord {
  detection_id:        uint64;
  range_m:             float;
  azimuth_deg:         float;
  elevation_deg:       float;
  infrared_snr_linear: float;
  visible_snr_linear:  float;
  fused_snr_linear:    float;
  fused_snr_db:        float;
  detected:            bool;
}

table EosDetectionAttributionRecord {
  detection_id:        uint64;
  target_id:           uint64;
  target_name:         string;
}

table EosOutputFrame {
  cycle_index:       uint32;
  scan_azimuth_deg:  float;
  detections:        [EosDetectionRecord];
}

// ---- EosCycleResult (cycle_output via StepWithResult) ----

table ValidationIssue {
  severity:     int32;
  code:         int32;
  location_kind: int32;
  entity_index: int32;
  field:        string;
  message:      string;
}

table EosCycleResult {
  input_cycle_index:      uint32;
  output_frame:           EosOutputFrame;
  detection_attributions: [EosDetectionAttributionRecord];
  validation_issues:      [ValidationIssue];
  has_validation_error:   bool;
  executed_this_cycle:    bool;
  reused_previous_output: bool;
  abort_reason:           int32;
}

// ---- FailureMarker (failure_marker 事件的 flatbuffer 载荷) ----
// 字段与 AR 模块的 FailureMarker 保持一致，用于在回放时结构化还原失败标记。

table FailureMarker {
  error_code:           string;
  message:              string;
  location:             string;
  has_cycle_index:      bool;
  cycle_index:          uint32;
  has_sim_time_sec:     bool;
  sim_time_sec:         double;
  diagnostics:          string;
  has_last_event_sequence: bool;
  last_event_sequence:  uint64;
}
