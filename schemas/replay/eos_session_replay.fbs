// eos_session_replay.fbs
// EOS 模块 replay FlatBuffers schema：session_config 与 runtime_config_patch 载荷
//
// file_identifier: EOSC (EOS Config)

namespace eos.replay;

// ---- EosSessionConfig ----

table EosMissionConfig {
  work_mode:                int32;
  horizontal_fov_deg:       float;
  vertical_fov_deg:         float;
  scan_rate_deg_per_sec:    float;
  frame_rate_hz:            float;
  scan_start_az_deg:        float;
  scan_end_az_deg:          float;
  scan_center_el_deg:       float;
  boresight_depression_deg: float;
  power_on:                 bool = true;
}

table EosPolicyDetectionConfig {
  minimum_snr_db:                   float;
  detection_sensitivity_w:          float;
  visible_reference_irradiance_w_m2: float;
}

table EosPolicyStrayLightConfig {
  enable_straylight_filter:  bool;
  hood_inner_half_angle_deg: float;
  hood_outer_half_angle_deg: float;
  hood_min_suppression_ratio: float;
  hood_max_suppression_ratio: float;
}

table EosPolicyConfig {
  detection:   EosPolicyDetectionConfig;
  stray_light: EosPolicyStrayLightConfig;
}

table EosAtmosphericObservation {
  enable_physical_model: bool;
  pressure_hpa:          float;
  temperature_k:         float;
  relative_humidity:     float;
}

table EosEnvironmentConfig {
  preset:              int32;
  atmospheric_physics: EosAtmosphericObservation;
  solar_altitude_deg:       float;
  solar_azimuth_deg:        float;
  solar_irradiance_w_m2:    float;
  cloud_coverage_ratio:     float;
  ambient_wind_speed_mps:   float;
  day_night_type:           int32;
  background_temperature_k: float;
}

table EosHardwareConfig {
  wavelength_lower_um:           float;
  wavelength_upper_um:           float;
  optical_aperture_m:            float;
  detector_detectivity_cm_sqrt_hz_per_w: float;
  detector_area_cm2:             float;
  min_detection_depression_deg:  float;
  max_detection_depression_deg:  float;
}

table EosSessionConfig {
  hardware:    EosHardwareConfig;
  mission:     EosMissionConfig;
  policy:      EosPolicyConfig;
  environment: EosEnvironmentConfig;
}

root_type EosSessionConfig;
file_identifier "EOSC";

// ---- EosRuntimeConfigPatch ----

table EosRuntimeConfigPatch {
  has_mission:              bool;
  mission:                  EosMissionConfig;
  has_policy:               bool;
  policy:                   EosPolicyConfig;
  has_environment:          bool;
  environment:              EosEnvironmentConfig;
  has_scenario_config_in_environment: bool;
  has_work_mode:            bool;
  work_mode:                int32;
  has_scan_rate_deg_per_sec: bool;
  scan_rate_deg_per_sec:    float;
  has_frame_rate_hz:        bool;
  frame_rate_hz:            float;
  has_sensor_enabled:       bool;
  sensor_enabled:           bool;
}
