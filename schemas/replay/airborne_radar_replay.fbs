namespace oneq.replay.airborne_radar.fb;

table Vector3f {
  x:float;
  y:float;
  z:float;
}

table EulerAnglesDeg {
  yaw_deg:float;
  pitch_deg:float;
  roll_deg:float;
}

table PoseState {
  position_m:Vector3f;
  velocity_mps:Vector3f;
  attitude_deg:EulerAnglesDeg;
}

table RadarSceneTarget {
  external_target_id:ulong;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  rcs:float;
  range_m:float;
  position_x:float;
  position_y:float;
  position_z:float;
  target_swerling_type:int;
}

table AtmosphericObservation {
  enable_physical_model:bool;
  pressure_hpa:float;
  temperature_k:float;
  relative_humidity:float;
}

table AtmosphericContext {
  has_simulation_unix_seconds:bool;
  simulation_unix_seconds:long;
  solar_flux_f107a:float;
  solar_flux_f107:float;
  geomagnetic_ap:float;
}

table SurfaceObservation {
  cover_profile:int;
  enable_physical_model:bool;
}

table JammerSource {
  technique:int;
  power_db:float;
  js_db:float;
  has_direction_deg:bool;
  azimuth_deg:float;
  elevation_deg:float;
  angular_span_deg:float;
  confidence:float;
}

table RadarCycleEnvironmentInput {
  atmospheric_observation:AtmosphericObservation;
  atmospheric_context:AtmosphericContext;
  surface_observation:SurfaceObservation;
  jammer_sources:[JammerSource];
}

table RadarCycleInput {
  cycle_index:uint = 0;
  dt_sec:float = 1.0;
  platform_pose:PoseState;
  scene:[RadarSceneTarget];
  environment:RadarCycleEnvironmentInput;
}

table TrackOutputFrame {
  cycle_index:uint;
  published_track_count:ulong;
  batch_id:ulong;
  confirmed_track_count:ulong;
  contains_lost_tracks:bool;
  tracks:[TrackStateSnapshot];
}

table DecisionTrackStateSnapshot {
  association_key:ulong;
  external_target_id:ulong;
  status:int;
  position_x:float;
  position_y:float;
  position_z:float;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  speed:float;
  acceleration_x:float;
  acceleration_y:float;
  acceleration_z:float;
  acceleration:float;
  rcs:float;
  jamming_detected:bool;
  hit_count:uint;
  miss_count:uint;
}

table TrackStateSnapshot {
  state:DecisionTrackStateSnapshot;
}

table RadarCycleResult {
  input_cycle_index:uint;
  track_output_frame:TrackOutputFrame;
  validation_issue_count:uint;
  executed_this_cycle:bool;
}

table FailureMarker {
  error_code:string;
  message:string;
  location:string;
  has_cycle_index:bool;
  cycle_index:uint;
  has_sim_time_sec:bool;
  sim_time_sec:double;
  diagnostics:string;
  has_last_event_sequence:bool;
  last_event_sequence:ulong;
}

root_type RadarCycleInput;
file_identifier "ARCI";
