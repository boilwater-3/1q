namespace oneq.replay.airborne_radar.fb;

table Vector3f {
  x:float;
  y:float;
  z:float;
}

table Vector3d { x:double; y:double; z:double; }
table RfUnitVector { x:double; y:double; z:double; }
table RfAntennaPattern {
  boresight_ecef_unit:RfUnitVector;
  peak_gain_dbi:double;
  half_power_beamwidth_deg:double;
  sidelobe_level_db:double;
  backlobe_level_db:double;
  cross_polarization_isolation_db:double;
}
table RfEmissionSegment {
  start_time_s:double;
  duration_s:double;
  center_frequency_hz:double;
  bandwidth_hz:double;
  transmit_power_w:double;
}
table RfEmission {
  emission_id:ulong;
  entity_id:ulong;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfAntennaPattern;
  polarization:int;
  waveform_kind:int;
  segments:[RfEmissionSegment];
}

table EulerAnglesDeg {
  yaw_deg:float;
  pitch_deg:float;
  roll_deg:float;
}

table PoseState {
  position_m:Vector3f;
  velocity_mps:Vector3f;
  attitude_deg:EulerAnglesDeg;
}

table ArSceneTarget {
  external_target_id:ulong;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  rcs:float;
  range_m:float;
  position_x:float;
  position_y:float;
  position_z:float;
  target_swerling_type:int;
  target_name:string;
}

table AtmosphericObservation {
  enable_physical_model:bool;
  pressure_hpa:float;
  temperature_k:float;
  relative_humidity:float;
}

table AtmosphericContext {
  has_simulation_unix_seconds:bool;
  simulation_unix_seconds:long;
  solar_flux_f107a:float;
  solar_flux_f107:float;
  geomagnetic_ap:float;
}

table SurfaceObservation {
  cover_profile:int;
  enable_physical_model:bool;
}

table JammerSource {
  technique:int;
  power_db:float;
  js_db:float;
  position_x:float;
  position_y:float;
  position_z:float;
  angular_span_deg:float;
  confidence:float;
}

table ArCycleEnvironmentInput {
  atmospheric_observation:AtmosphericObservation;
  atmospheric_context:AtmosphericContext;
  surface_observation:SurfaceObservation;
  jammer_sources:[JammerSource];
  // -1 marks traces created before tagged interference was introduced.
  interference_mode:int = -1;
  engineering_emissions:[RfEmission];
}

table ArCycleInput {
  cycle_index:uint = 0;
  dt_sec:float = 1.0;
  platform_pose:PoseState;
  scene:[ArSceneTarget];
  has_environment:bool = false;
  environment:ArCycleEnvironmentInput;
  platform_altitude_m:float = 0.0;
  platform_entity_id:ulong = 0;
  has_platform_ecef_kinematics:bool = false;
  platform_position_ecef_m:Vector3d;
  platform_velocity_ecef_mps:Vector3d;
}

table TrackOutputFrame {
  cycle_index:uint;
  published_track_count:ulong;
  batch_id:ulong;
  confirmed_track_count:ulong;
  contains_lost_tracks:bool;
  tracks:[TrackStateSnapshot];
}

table DecisionTrackStateSnapshot {
  association_key:ulong;
  external_target_id:ulong;
  status:int;
  position_x:float;
  position_y:float;
  position_z:float;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  speed:float;
  acceleration_x:float;
  acceleration_y:float;
  acceleration_z:float;
  acceleration:float;
  rcs:float;
  hit_count:uint;
  miss_count:uint;
  target_type:string;
  target_probability:float;
  target_name:string;
}

table TrackStateSnapshot {
  state:DecisionTrackStateSnapshot;
}

table ValidationIssue {
  severity:int;
  code:int;
  location_kind:int;
  entity_index:int;
  field:string;
  message:string;
}

table ArCommand {
  type:int;
  source:int;
}

table ArControlProfile {
  version:ulong;
  enable_lpi_power_control:bool;
  lpi_power_scale:float;
  enable_lpi_beamforming:bool;
  lpi_dwell_scale:float;
  enable_agility_frequency:bool;
  agility_frequency_hop_phase:ubyte;
  enable_sidelobe_canceller:bool;
  enable_adaptive_beamforming:bool;
  enable_eccm_rejitter:bool;
  eccm_burnthrough_gain:float;
}

table AssociationQualityMetrics {
  prior_track_count:ulong;
  detection_count:ulong;
  matched_count:ulong;
  new_track_count:ulong;
  missed_track_count:ulong;
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  association_stress:float;
}

table ArInterferenceObservation {
  observation_id:ulong;
  estimated_bearing_azimuth_deg:double;
  estimated_bearing_elevation_deg:double;
  estimated_off_boresight_deg:double;
  estimated_center_frequency_hz:double;
  estimated_bandwidth_hz:double;
  estimated_waveform_kind:int;
  jammer_to_noise_db:double;
  bearing_standard_deviation_deg:double;
  frequency_standard_deviation_hz:double;
  bandwidth_standard_deviation_hz:double;
}

table AssociationQualityInfo {
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  association_stress:float;
}

table PerceptionQualityInfo {
  input_target_count:ulong;
  detection_count:ulong;
  detection_rate:float;
  detection_stress:float;
}

table DecisionInputFrame {
  cycle_index:uint;
  batch_id:ulong;
  interference_observations:[ArInterferenceObservation];
  association_quality_info:AssociationQualityInfo;
  perception_quality_info:PerceptionQualityInfo;
  tracks:[TrackStateSnapshot];
}

table DecisionObservation {
  input_frame:DecisionInputFrame;
  active_control_profile:ArControlProfile;
}

table ControlDirective {
  type:int;
  source:int;
  has_requested_value:bool;
  requested_value:float;
}

table TacticalProposal {
  directive:ControlDirective;
  priority:int;
  rationale:string;
}

table ExternalDecisionResponse {
  source_cycle_index:uint;
  source_batch_id:ulong;
  proposals:[TacticalProposal];
}

table ArCycleResult {
  input_cycle_index:uint;
  track_output_frame:TrackOutputFrame;
  submitted_commands:[ArCommand];
  validation_issues:[ValidationIssue];
  has_validation_error:bool;
  executed_this_cycle:bool;
  abort_reason:int;
  reused_previous_output:bool;
  has_control_profile:bool;
  control_profile:ArControlProfile;
  association_quality_metrics:AssociationQualityMetrics;
  has_decision_observation:bool;
  decision_observation:DecisionObservation;
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
}

table ArDecisionReplayState {
  has_pending_internal_decision:bool;
  pending_internal_cycle_index:uint;
  pending_internal_batch_id:ulong;
  pending_internal_proposals:[TacticalProposal];
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
  applied_decision_proposals:[TacticalProposal];
  has_pending_external_decision:bool;
  pending_external_decision:ExternalDecisionResponse;
  lpi_hold_cycles_remaining:uint;
  eccm_hold_cycles_remaining:uint;
  lpi_cooldown_cycles_remaining:uint;
  eccm_cooldown_cycles_remaining:uint;
}

table ArReplayCycleRecord {
  result:ArCycleResult;
  decision_state:ArDecisionReplayState;
}

table FailureMarker {
  error_code:string;
  message:string;
  location:string;
  has_cycle_index:bool;
  cycle_index:uint;
  has_sim_time_sec:bool;
  sim_time_sec:double;
  diagnostics:string;
  has_last_event_sequence:bool;
  last_event_sequence:ulong;
}

// RF scene v2 replay payloads. The v1 tables above remain only until the AR
// single-stage public path is deleted; new AR traces exclusively use these.
table RfSceneDirectionV2 { x:double; y:double; z:double; }
table RfSceneAntennaPatternV2 {
  boresight_ecef:RfSceneDirectionV2;
  peak_gain_dbi:double;
  half_power_beamwidth_deg:double;
  sidelobe_level_db:double;
  backlobe_level_db:double;
  cross_polarization_isolation_db:double;
}
table RfEmissionIdentityV2 {
  platform_id:ulong;
  equipment_id:ulong;
  emission_id:ulong;
}
table RfWaveformScheduleV2 {
  kind:int;
  activity_start_time_s:double;
  activity_duration_s:double;
  center_frequency_hz:double;
  occupied_bandwidth_hz:double;
  transmit_power_w:double;
  pulse_width_s:double;
  pulse_repetition_interval_s:double;
  first_pulse_time_s:double;
  pulse_count:uint;
  pulse_jitter_fraction:double;
  timing_seed:ulong;
  timing_epoch:ulong;
  sweep_start_frequency_hz:double;
  sweep_stop_frequency_hz:double;
  sweep_period_s:double;
}
table RfSceneEmissionV2 {
  identity:RfEmissionIdentityV2;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfSceneAntennaPatternV2;
  polarization:int;
  waveform:RfWaveformScheduleV2;
}
table RfSceneFrameV2 {
  world_cycle_index:ulong;
  window_start_time_s:double;
  window_duration_s:double;
  emissions:[RfSceneEmissionV2];
}
table RfCoSiteIsolationPathV2 {
  transmitter_equipment_id:ulong;
  receiver_equipment_id:ulong;
  isolation_db:double;
}
table RfSceneReceiverStateV2 {
  platform_id:ulong;
  equipment_id:ulong;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfSceneAntennaPatternV2;
  polarization:int;
  window_start_time_s:double;
  window_duration_s:double;
  center_frequency_hz:double;
  bandwidth_hz:double;
  receiver_system_loss_db:double;
  minimum_far_field_range_m:double;
  co_site_paths:[RfCoSiteIsolationPathV2];
}
table EulerAnglesDeg64 { yaw_deg:double; pitch_deg:double; roll_deg:double; }
table AzimuthElevationDeg32 { az_deg:float; el_deg:float; }
table ArPreparedCycleTokenV2 { value:ulong; world_cycle_index:ulong; }
table ArPrepareCycleInputV2 {
  world_cycle_index:ulong;
  window_start_time_s:double;
  window_duration_s:double;
  platform_id:ulong;
  platform_position_ecef_m:Vector3d;
  platform_velocity_ecef_mps:Vector3d;
  radar_frame_attitude_deg:EulerAnglesDeg64;
  beam_pointing_deg:AzimuthElevationDeg32;
}
table ArReceiverOperatingStateV2 {
  rf_receiver:RfSceneReceiverStateV2;
  beam_pointing_deg:AzimuthElevationDeg32;
  matched_filter_bandwidth_hz:double;
  receiver_noise_figure_db:double;
  maximum_linear_input_power_w:double;
  transmit_receive_blanking_enabled:bool;
  adaptive_nulls_ecef:[RfSceneDirectionV2];
}
table ArPrepareCycleResultV2 {
  status:int;
  token:ArPreparedCycleTokenV2;
  has_emission:bool;
  emission:RfSceneEmissionV2;
  operating_state:ArReceiverOperatingStateV2;
}
table ArSessionReplayStateV2 {
  has_prepared_cycle:bool;
  prepared_token:ArPreparedCycleTokenV2;
  has_world_chronology:bool;
  last_world_window_end_s:double;
  next_token_value:ulong;
  next_emission_id:ulong;
  successful_prepare_count:ulong;
  timing_seed:ulong;
  frequency_hop_index:ulong;
  has_pending_runtime_update:bool;
  pending_execution_config_changed:bool;
  pending_environment_scenario_config_changed:bool;
  pending_jamming_sensitivity_profile_changed:bool;
  decision_state:ArDecisionReplayState;
}
table ArPrepareReplayRecordV2 {
  result:ArPrepareCycleResultV2;
  session_state:ArSessionReplayStateV2;
}
table ArCompleteReplayOperationInputV2 {
  token:ArPreparedCycleTokenV2;
  rf_scene:RfSceneFrameV2;
  targets:[ArSceneTarget];
  atmospheric_observation:AtmosphericObservation;
  atmospheric_context:AtmosphericContext;
  surface_observation:SurfaceObservation;
}
table ArCompleteCycleResultV2 {
  status:int;
  world_cycle_index:ulong;
  track_output_frame:TrackOutputFrame;
  interference_observations:[ArInterferenceObservation];
  receiver_impairment:int;
  has_decision_observation:bool;
  decision_observation:DecisionObservation;
}
table ArCompleteReplayRecordV2 {
  result:ArCompleteCycleResultV2;
  session_state:ArSessionReplayStateV2;
}
table ArAbandonReplayOperationInputV2 { token:ArPreparedCycleTokenV2; }
table ArAbandonReplayRecordV2 {
  status:int;
  session_state:ArSessionReplayStateV2;
}
table ArRuntimeConfigAttemptV2 {
  patch_payload:[ubyte];
  accepted:bool;
}
table ArExternalDecisionAttemptV2 {
  response_payload:[ubyte];
  status:int;
}

root_type ArCycleInput;
file_identifier "ARCI";
