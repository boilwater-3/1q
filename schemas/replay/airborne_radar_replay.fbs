namespace oneq.replay.airborne_radar.fb;

table Vector3d { x:double; y:double; z:double; }

table TrackOutputFrame {
  cycle_index:uint;
  published_track_count:ulong;
  batch_id:ulong;
  confirmed_track_count:ulong;
  contains_lost_tracks:bool;
  tracks:[TrackStateSnapshot];
}

table DecisionTrackStateSnapshot {
  association_key:ulong;
  external_target_id:ulong;
  status:int;
  position_x:float;
  position_y:float;
  position_z:float;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  speed:float;
  acceleration_x:float;
  acceleration_y:float;
  acceleration_z:float;
  acceleration:float;
  rcs:float;
  hit_count:uint;
  miss_count:uint;
  target_type:string;
  target_probability:float;
  target_name:string;
}

table TrackStateSnapshot {
  state:DecisionTrackStateSnapshot;
}

table ArControlProfile {
  version:ulong;
  enable_lpi_power_control:bool;
  lpi_power_scale:float;
  enable_lpi_beamforming:bool;
  lpi_dwell_scale:float;
  enable_agility_frequency:bool;
  agility_frequency_hop_phase:ubyte;
  enable_sidelobe_canceller:bool;
  enable_adaptive_beamforming:bool;
  enable_eccm_rejitter:bool;
  eccm_burnthrough_gain:float;
  enable_anti_rgpo_leading_edge:bool;
  enable_anti_vgpo_acceleration_bound:bool;
  enable_anti_false_target_discrimination:bool;
}

// 外部 profile 覆盖提交（整包替换值）的回放载荷，用作 decision_input 事件根表。
table ArControlProfilePayload {
  profile:ArControlProfile;
}

table ArInterferenceObservation {
  observation_id:ulong;
  estimated_bearing_azimuth_deg:double;
  estimated_bearing_elevation_deg:double;
  estimated_off_boresight_deg:double;
  estimated_center_frequency_hz:double;
  estimated_bandwidth_hz:double;
  estimated_waveform_kind:int;
  jammer_to_noise_db:double;
  bearing_standard_deviation_deg:double;
  frequency_standard_deviation_hz:double;
  bandwidth_standard_deviation_hz:double;
  deception_class:int;
  coherent_emission_count:uint;
  estimated_slant_range_m:double;
  has_local_bearings:bool;
  estimated_bearing_azimuth_local_deg:double;
  estimated_bearing_elevation_local_deg:double;
  estimated_range_rate_mps:double;
  estimated_carrier_offset_hz:double;
  estimated_first_pulse_delay_s:double;
}

table AssociationQualityInfo {
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  association_stress:float;
}

table PerceptionQualityInfo {
  input_target_count:ulong;
  detection_count:ulong;
  detection_rate:float;
  detection_stress:float;
}

table DecisionInputFrame {
  cycle_index:uint;
  batch_id:ulong;
  interference_observations:[ArInterferenceObservation];
  association_quality_info:AssociationQualityInfo;
  perception_quality_info:PerceptionQualityInfo;
  tracks:[TrackStateSnapshot];
}

table DecisionObservation {
  input_frame:DecisionInputFrame;
  active_control_profile:ArControlProfile;
}

table ControlDirective {
  type:int;
  source:int;
  has_requested_value:bool;
  requested_value:float;
}

table TacticalProposal {
  directive:ControlDirective;
  priority:int;
  rationale:string;
}

table ArDecisionReplayState {
  has_pending_internal_decision:bool;
  pending_internal_cycle_index:uint;
  pending_internal_batch_id:ulong;
  pending_internal_proposals:[TacticalProposal];
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
  applied_decision_proposals:[TacticalProposal];
  lpi_hold_cycles_remaining:uint;
  eccm_hold_cycles_remaining:uint;
  lpi_cooldown_cycles_remaining:uint;
  eccm_cooldown_cycles_remaining:uint;
}

table FailureMarker {
  error_code:string;
  message:string;
  location:string;
  has_cycle_index:bool;
  cycle_index:uint;
  has_sim_time_sec:bool;
  sim_time_sec:double;
  diagnostics:string;
  has_last_event_sequence:bool;
  last_event_sequence:ulong;
}

// RF scene v2 replay payloads.
table RfSceneDirectionV2 { x:double; y:double; z:double; }
table RfSceneAntennaPatternV2 {
  boresight_ecef:RfSceneDirectionV2;
  peak_gain_dbi:double;
  half_power_beamwidth_deg:double;
  sidelobe_level_db:double;
  backlobe_level_db:double;
  cross_polarization_isolation_db:double;
}
table RfEmissionIdentityV2 {
  platform_id:ulong;
  equipment_id:ulong;
  emission_id:ulong;
}
table RfWaveformScheduleV2 {
  kind:int;
  activity_start_time_s:double;
  activity_duration_s:double;
  center_frequency_hz:double;
  occupied_bandwidth_hz:double;
  transmit_power_w:double;
  pulse_width_s:double;
  pulse_repetition_interval_s:double;
  first_pulse_time_s:double;
  pulse_count:uint;
  pulse_jitter_fraction:double;
  timing_seed:ulong;
  timing_epoch:ulong;
  sweep_start_frequency_hz:double;
  sweep_stop_frequency_hz:double;
  sweep_period_s:double;
}
table RfSceneEmissionV2 {
  identity:RfEmissionIdentityV2;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfSceneAntennaPatternV2;
  polarization:int;
  waveform:RfWaveformScheduleV2;
}
table RfSceneFrameV2 {
  world_cycle_index:ulong;
  window_start_time_s:double;
  window_duration_s:double;
  emissions:[RfSceneEmissionV2];
}
table EulerAnglesDeg64 { yaw_deg:double; pitch_deg:double; roll_deg:double; }
table AzimuthElevationDeg32 { az_deg:float; el_deg:float; }
table ArRuntimeConfigAttemptV2 {
  patch_payload:[ubyte];
  accepted:bool;
}

// Single-cycle AR user facade. Two-stage AR records were deliberately removed;
// current replay accepts only V3 cycle records.
table LlaPositionV3 {
  latitude_deg:double;
  longitude_deg:double;
  altitude_m:double;
}
table EcefVelocityV3 { x_mps:double; y_mps:double; z_mps:double; }
table ArPlatformInputV3 {
  platform_entity_id:ulong;
  platform_position_ecef_m:Vector3d;
  platform_velocity_mps:EcefVelocityV3;
  platform_attitude_deg:EulerAnglesDeg64;
  radar_mount_angles_deg:EulerAnglesDeg64 (deprecated);
}
table ExternalKinematicsV3 {
  position_frame:int;
  position_ecef_m:Vector3d;
  position_lla_deg_m:LlaPositionV3;
  velocity_mps:EcefVelocityV3;
  attitude_deg:EulerAnglesDeg64;
}
table ArTargetInputV3 {
  target_id:ulong;
  target_name:string;
  kinematics:ExternalKinematicsV3;
  rcs:float;
  swerling_type:int;
}
table ArCycleInputV3 {
  cycle_index:uint;
  cycle_start_time_s:double;
  dt_sec:double;
  platform:ArPlatformInputV3;
  targets:[ArTargetInputV3];
  interference:RfSceneFrameV2;
}
table ArCommandV3 { type:int; source:int; }
table ValidationIssueV3 {
  severity:int;
  code:int;
  location_kind:int;
  entity_index:ulong;
  field:string;
  message:string;
}
table AssociationQualityMetricsV3 {
  prior_track_count:ulong;
  detection_count:ulong;
  matched_count:ulong;
  new_track_count:ulong;
  missed_track_count:ulong;
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  association_stress:float;
}
table ArCycleResultV3 {
  input_cycle_index:uint;
  status:int;
  track_output_frame:TrackOutputFrame;
  emission_frame:RfSceneFrameV2;
  receiver_impairment:int;
  interference_observations:[ArInterferenceObservation];
  submitted_commands:[ArCommandV3];
  validation_issues:[ValidationIssueV3];
  has_validation_error:bool;
  abort_reason:int;
  has_control_profile:bool;
  control_profile:ArControlProfile;
  association_quality_metrics:AssociationQualityMetricsV3;
  has_decision_observation:bool;
  decision_observation:DecisionObservation;
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
}
table ArSessionReplayStateV3 {
  has_world_chronology:bool;
  last_world_window_end_s:double;
  next_emission_id:ulong;
  successful_prepare_count:ulong;
  timing_seed:ulong;
  frequency_hop_index:ulong;
  has_pending_runtime_update:bool;
  pending_execution_config_changed:bool;
  pending_environment_scenario_config_changed:bool;
  decision_state:ArDecisionReplayState;
}
table ArCycleReplayRecordV3 {
  result:ArCycleResultV3;
  session_state:ArSessionReplayStateV3;
}

root_type ArCycleInputV3;
file_identifier "ARC3";
