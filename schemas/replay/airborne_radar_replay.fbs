namespace oneq.replay.airborne_radar.fb;

table Vector3f {
  x:float;
  y:float;
  z:float;
}

table Vector3d { x:double; y:double; z:double; }
table RfUnitVector { x:double; y:double; z:double; }
table RfAntennaPattern {
  boresight_ecef_unit:RfUnitVector;
  peak_gain_dbi:double;
  half_power_beamwidth_deg:double;
  sidelobe_level_db:double;
  backlobe_level_db:double;
  cross_polarization_isolation_db:double;
}
table RfEmissionSegment {
  start_time_s:double;
  duration_s:double;
  center_frequency_hz:double;
  bandwidth_hz:double;
  transmit_power_w:double;
}
table RfEmission {
  emission_id:ulong;
  entity_id:ulong;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfAntennaPattern;
  polarization:int;
  waveform_kind:int;
  segments:[RfEmissionSegment];
}

table EulerAnglesDeg {
  yaw_deg:float;
  pitch_deg:float;
  roll_deg:float;
}

table PoseState {
  position_m:Vector3f;
  velocity_mps:Vector3f;
  attitude_deg:EulerAnglesDeg;
}

table ArSceneTarget {
  external_target_id:ulong;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  rcs:float;
  range_m:float;
  position_x:float;
  position_y:float;
  position_z:float;
  target_swerling_type:int;
  target_name:string;
}

table AtmosphericObservation {
  enable_physical_model:bool;
  pressure_hpa:float;
  temperature_k:float;
  relative_humidity:float;
}

table AtmosphericContext {
  has_simulation_unix_seconds:bool;
  simulation_unix_seconds:long;
  solar_flux_f107a:float;
  solar_flux_f107:float;
  geomagnetic_ap:float;
}

table SurfaceObservation {
  cover_profile:int;
  enable_physical_model:bool;
}

table JammerSource {
  technique:int;
  power_db:float;
  js_db:float;
  position_x:float;
  position_y:float;
  position_z:float;
  angular_span_deg:float;
  confidence:float;
}

table ArCycleEnvironmentInput {
  atmospheric_observation:AtmosphericObservation;
  atmospheric_context:AtmosphericContext;
  surface_observation:SurfaceObservation;
  jammer_sources:[JammerSource];
  // -1 marks traces created before tagged interference was introduced.
  interference_mode:int = -1;
  engineering_emissions:[RfEmission];
}

table ArCycleInput {
  cycle_index:uint = 0;
  dt_sec:float = 1.0;
  platform_pose:PoseState;
  scene:[ArSceneTarget];
  has_environment:bool = false;
  environment:ArCycleEnvironmentInput;
  platform_altitude_m:float = 0.0;
  platform_entity_id:ulong = 0;
  has_platform_ecef_kinematics:bool = false;
  platform_position_ecef_m:Vector3d;
  platform_velocity_ecef_mps:Vector3d;
}

table TrackOutputFrame {
  cycle_index:uint;
  published_track_count:ulong;
  batch_id:ulong;
  confirmed_track_count:ulong;
  contains_lost_tracks:bool;
  tracks:[TrackStateSnapshot];
}

table DecisionTrackStateSnapshot {
  association_key:ulong;
  external_target_id:ulong;
  status:int;
  position_x:float;
  position_y:float;
  position_z:float;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  speed:float;
  acceleration_x:float;
  acceleration_y:float;
  acceleration_z:float;
  acceleration:float;
  rcs:float;
  hit_count:uint;
  miss_count:uint;
  target_type:string;
  target_probability:float;
  target_name:string;
}

table TrackStateSnapshot {
  state:DecisionTrackStateSnapshot;
}

table ValidationIssue {
  severity:int;
  code:int;
  location_kind:int;
  entity_index:int;
  field:string;
  message:string;
}

table ArCommand {
  type:int;
  source:int;
}

table ArControlProfile {
  version:ulong;
  enable_lpi_power_control:bool;
  lpi_power_scale:float;
  enable_lpi_beamforming:bool;
  lpi_dwell_scale:float;
  enable_agility_frequency:bool;
  agility_frequency_hop_phase:ubyte;
  enable_sidelobe_canceller:bool;
  enable_adaptive_beamforming:bool;
  enable_eccm_rejitter:bool;
  eccm_burnthrough_gain:float;
}

table AssociationQualityMetrics {
  prior_track_count:ulong;
  detection_count:ulong;
  matched_count:ulong;
  new_track_count:ulong;
  missed_track_count:ulong;
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  dominant_jamming_semantic:int;
  jamming_severity:float;
  association_stress:float;
}

table EccmJammerDirectionDeg {
  azimuth_deg:float;
  elevation_deg:float;
}

table EccmJammerSourceInfo {
  technique:int;
  jammer_power_db:float;
  jammer_to_signal_db:float;
  frequency_overlap_ratio:float;
  prf_lock_risk:float;
  has_direction_deg:bool;
  direction_deg:EccmJammerDirectionDeg;
  angular_span_deg:float;
  jammer_in_sidelobe:bool;
  confidence:float;
}

table EccmSourceInfo {
  has_jamming_signal:bool;
  jammer_sources:[EccmJammerSourceInfo];
}

table AssociationQualityInfo {
  match_rate:float;
  new_track_rate:float;
  missed_track_rate:float;
  mean_match_cost:float;
  p95_match_cost:float;
  dominant_jamming_semantic:int;
  jamming_severity:float;
  association_stress:float;
}

table PerceptionQualityInfo {
  input_target_count:ulong;
  detection_count:ulong;
  detection_rate:float;
  detection_stress:float;
}

table DecisionInputFrame {
  cycle_index:uint;
  batch_id:ulong;
  environment_jamming_detected:bool;
  eccm_source_info:EccmSourceInfo;
  association_quality_info:AssociationQualityInfo;
  perception_quality_info:PerceptionQualityInfo;
  tracks:[TrackStateSnapshot];
}

table DecisionObservation {
  input_frame:DecisionInputFrame;
  active_control_profile:ArControlProfile;
}

table ControlDirective {
  type:int;
  source:int;
  has_requested_value:bool;
  requested_value:float;
}

table TacticalProposal {
  directive:ControlDirective;
  priority:int;
  rationale:string;
}

table ExternalDecisionResponse {
  source_cycle_index:uint;
  source_batch_id:ulong;
  proposals:[TacticalProposal];
}

table ArCycleResult {
  input_cycle_index:uint;
  track_output_frame:TrackOutputFrame;
  submitted_commands:[ArCommand];
  validation_issues:[ValidationIssue];
  has_validation_error:bool;
  executed_this_cycle:bool;
  abort_reason:int;
  reused_previous_output:bool;
  has_control_profile:bool;
  control_profile:ArControlProfile;
  association_quality_metrics:AssociationQualityMetrics;
  has_decision_observation:bool;
  decision_observation:DecisionObservation;
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
}

table ArDecisionReplayState {
  has_pending_internal_decision:bool;
  pending_internal_cycle_index:uint;
  pending_internal_batch_id:ulong;
  pending_internal_proposals:[TacticalProposal];
  applied_decision_source:int;
  applied_decision_cycle_index:uint;
  applied_decision_batch_id:ulong;
  applied_decision_proposals:[TacticalProposal];
  has_pending_external_decision:bool;
  pending_external_decision:ExternalDecisionResponse;
  lpi_hold_cycles_remaining:uint;
  eccm_hold_cycles_remaining:uint;
  lpi_cooldown_cycles_remaining:uint;
  eccm_cooldown_cycles_remaining:uint;
}

table ArReplayCycleRecord {
  result:ArCycleResult;
  decision_state:ArDecisionReplayState;
}

table FailureMarker {
  error_code:string;
  message:string;
  location:string;
  has_cycle_index:bool;
  cycle_index:uint;
  has_sim_time_sec:bool;
  sim_time_sec:double;
  diagnostics:string;
  has_last_event_sequence:bool;
  last_event_sequence:ulong;
}

root_type ArCycleInput;
file_identifier "ARCI";
