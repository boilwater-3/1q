@PACKAGE_INIT@

# 检查依赖的 CMake 版本
include(CMakeFindDependencyMacro)

find_dependency(Eigen3 REQUIRED CONFIG)
find_dependency(spdlog REQUIRED CONFIG)
find_dependency(eventpp REQUIRED CONFIG)
find_dependency(Boost REQUIRED CONFIG)

# 导入目标
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

# 提供包变量
check_required_components(@PROJECT_NAME@)

# 设置包信息变量
set(@PROJECT_NAME@_VERSION @PROJECT_VERSION@)
set(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@::@PROJECT_NAME_LOWER@)
