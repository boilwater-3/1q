{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            },
            "cacheVariables": {
                "PACKAGE_MANAGER": "vcpkg",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports"
            }
        },
        {
            "name": "vs2022-base",
            "hidden": true,
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64"
        },
        {
            "name": "vs2017-base",
            "hidden": true,
            "inherits": "windows-base",
            "generator": "Visual Studio 15 2017",
            "toolset": "host=x64",
            "architecture": "x64"
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "apple.com/Xcode/CMake/1.0": {
                    "hostOS": [
                        "macOS"
                    ]
                }
            },
            "generator": "Ninja",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan"
            }
        },
        {
            "name": "vs2022",
            "inherits": "vs2022-base",
            "displayName": "Visual Studio 2022 (x64)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "vs2017",
            "inherits": "vs2017-base",
            "displayName": "Visual Studio 2017 (x64)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Debug",
            "binaryDir": "${sourceDir}/build/llvm-ninja-debug-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/llvm-ninja-debug-local/build/Debug/generators/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "ENABLE_STRESS_TESTING": "OFF",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "ON",
                "ENABLE_STRESS_TESTING": "OFF",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "windows-conan-vs2015-release",
            "inherits": "base",
            "displayName": "Windows Conan VS2015 Release (x64 DLL)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 14 2015",
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan",
                "BUILD_SHARED_LIBS": "ON",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-conan-vs2015-release/conan_toolchain.cmake"
            }
        },
        {
            "name": "windows-conan-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan",
                "BUILD_SHARED_LIBS": "ON",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "windows-conan-release",
            "inherits": "windows-conan-base",
            "displayName": "Windows Conan Release (x64 DLL)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-conan-release/conan_toolchain.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release"
        },
        {
            "name": "vs2022-relwithdebinfo",
            "configurePreset": "vs2022",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "vs2022-minsizerel",
            "configurePreset": "vs2022",
            "configuration": "MinSizeRel"
        },
        {
            "name": "vs2017-debug",
            "configurePreset": "vs2017",
            "configuration": "Debug"
        },
        {
            "name": "vs2017-release",
            "configurePreset": "vs2017",
            "configuration": "Release"
        },
        {
            "name": "vs2017-relwithdebinfo",
            "configurePreset": "vs2017",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "vs2017-minsizerel",
            "configurePreset": "vs2017",
            "configuration": "MinSizeRel"
        },
        {
            "name": "llvm-ninja-debug",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-release",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "windows-conan-release",
            "configurePreset": "windows-conan-release",
            "configuration": "Release"
        },
        {
            "name": "windows-conan-vs2015-release",
            "configurePreset": "windows-conan-vs2015-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "vs2022-debug",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "Release"
        },
        {
            "name": "vs2022-relwithdebinfo",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "vs2022-minsizerel",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "MinSizeRel"
        },
        {
            "name": "vs2017-debug",
            "inherits": "test-base",
            "configurePreset": "vs2017",
            "configuration": "Debug"
        },
        {
            "name": "vs2017-release",
            "inherits": "test-base",
            "configurePreset": "vs2017",
            "configuration": "Release"
        },
        {
            "name": "vs2017-relwithdebinfo",
            "inherits": "test-base",
            "configurePreset": "vs2017",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "vs2017-minsizerel",
            "inherits": "test-base",
            "configurePreset": "vs2017",
            "configuration": "MinSizeRel"
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug",
            "filter": {
                "exclude": {
                    "label": "stress"
                }
            }
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-release",
            "filter": {
                "exclude": {
                    "label": "stress"
                }
            }
        },
        {
            "name": "llvm-ninja-debug-stress",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug",
            "filter": {
                "include": {
                    "label": "stress"
                }
            }
        },
        {
            "name": "llvm-ninja-release-stress",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-release",
            "filter": {
                "include": {
                    "label": "stress"
                }
            }
        }
    ]
}
