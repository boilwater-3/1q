{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "apple.com/Xcode/CMake/1.0": {
                    "hostOS": [
                        "macOS"
                    ]
                }
            },
            "generator": "Ninja",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan"
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Debug",
            "binaryDir": "${sourceDir}/build/llvm-ninja-debug-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "llvm-ninja-debug-eigen339",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Debug with Conan Eigen 3.3.9",
            "binaryDir": "${sourceDir}/build/llvm-ninja-debug-eigen339-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "CONAN_EIGEN_VERSION": "3.3.9"
            }
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Release",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "macos-jsbsim-debug-base",
            "hidden": true,
            "inherits": "macos-base",
            "displayName": "macOS JSBSim Debug Base (hidden — inherit for LLDB source debugging)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "USE_CCACHE": "ON",
                "ENABLE_PCH": "ON",
                "ENABLE_UNITY_BUILD": "OFF"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake"
            }
        },
        {
            "name": "windows-vs2015",
            "inherits": "windows-base",
            "displayName": "Windows VS2015 x64",
            "generator": "Visual Studio 14 2015",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "vendor-debug-windows-local-vs2015",
            "inherits": "windows-vs2015",
            "displayName": "Windows Vendor Debug VS2015 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-debug-windows-local-vs2015",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON"
            }
        },
        {
            "name": "vendor-release-windows-local-vs2015",
            "inherits": "windows-vs2015",
            "displayName": "Windows Vendor Release VS2015 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-release-windows-local-vs2015",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "windows-vs2017",
            "inherits": "windows-base",
            "displayName": "Windows VS2017 x64 (via VS2026 v141 toolset)",
            "generator": "Visual Studio 18 2026",
            "toolset": "v141,host=x64",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "vendor-debug-windows-local-vs2017",
            "inherits": "windows-vs2017",
            "displayName": "Windows Vendor Debug VS2017 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-debug-windows-local-vs2017",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON"
            }
        },
        {
            "name": "vendor-release-windows-local-vs2017",
            "inherits": "windows-vs2017",
            "displayName": "Windows Vendor Release VS2017 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-release-windows-local-vs2017",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "windows-vs2019",
            "inherits": "windows-base",
            "displayName": "Windows VS2019 x64 (via VS2026 v142 toolset)",
            "generator": "Visual Studio 18 2026",
            "toolset": "v142,host=x64",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF"
            }
        },
        {
            "name": "vendor-debug-windows-local-vs2019",
            "inherits": "windows-vs2019",
            "displayName": "Windows Vendor Debug VS2019 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-debug-windows-local-vs2019",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON"
            }
        },
        {
            "name": "vendor-release-windows-local-vs2019",
            "inherits": "windows-vs2019",
            "displayName": "Windows Vendor Release VS2019 (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-release-windows-local-vs2019",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "llvm-ninja-debug",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-debug-eigen339",
            "configurePreset": "llvm-ninja-debug-eigen339"
        },
        {
            "name": "llvm-ninja-release",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "vendor-debug-windows-local-vs2015",
            "configurePreset": "vendor-debug-windows-local-vs2015"
        },
        {
            "name": "vendor-release-windows-local-vs2015",
            "configurePreset": "vendor-release-windows-local-vs2015",
            "configuration": "Release"
        },
        {
            "name": "vendor-debug-windows-local-vs2017",
            "configurePreset": "vendor-debug-windows-local-vs2017"
        },
        {
            "name": "vendor-release-windows-local-vs2017",
            "configurePreset": "vendor-release-windows-local-vs2017",
            "configuration": "Release"
        },
        {
            "name": "vendor-debug-windows-local-vs2019",
            "configurePreset": "vendor-debug-windows-local-vs2019"
        },
        {
            "name": "vendor-release-windows-local-vs2019",
            "configurePreset": "vendor-release-windows-local-vs2019",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2019",
            "configurePreset": "windows-vs2019",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2015",
            "configurePreset": "windows-vs2015",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2017",
            "configurePreset": "windows-vs2017",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-debug-eigen339",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug-eigen339"
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "vendor-debug-windows-local-vs2015",
            "inherits": "test-base",
            "configurePreset": "vendor-debug-windows-local-vs2015",
            "configuration": "Debug"
        },
        {
            "name": "vendor-release-windows-local-vs2015",
            "inherits": "test-base",
            "configurePreset": "vendor-release-windows-local-vs2015",
            "configuration": "Release"
        },
        {
            "name": "vendor-debug-windows-local-vs2017",
            "inherits": "test-base",
            "configurePreset": "vendor-debug-windows-local-vs2017",
            "configuration": "Debug"
        },
        {
            "name": "vendor-release-windows-local-vs2017",
            "inherits": "test-base",
            "configurePreset": "vendor-release-windows-local-vs2017",
            "configuration": "Release"
        },
        {
            "name": "vendor-debug-windows-local-vs2019",
            "inherits": "test-base",
            "configurePreset": "vendor-debug-windows-local-vs2019",
            "configuration": "Debug"
        },
        {
            "name": "vendor-release-windows-local-vs2019",
            "inherits": "test-base",
            "configurePreset": "vendor-release-windows-local-vs2019",
            "configuration": "Release"
        }
    ]
}
