{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "apple.com/Xcode/CMake/1.0": {
                    "hostOS": [
                        "macOS"
                    ]
                }
            },
            "generator": "Ninja",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan"
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Debug",
            "binaryDir": "${sourceDir}/build/llvm-ninja-debug-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Release",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "vendor-debug-mac-local",
            "inherits": "macos-base",
            "displayName": "macOS Vendor Debug (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-debug-mac-local",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan",
                "ENABLE_INSTALL": "ON",
                "ENABLE_TESTING": "OFF",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ConanBootstrapToolchain.cmake"
            }
        },
        {
            "name": "windows-vs2015",
            "inherits": "windows-base",
            "displayName": "Windows VS2015 x64",
            "generator": "Visual Studio 14 2015",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_TESTING": "ON"
            }
        },
        {
            "name": "vendor-debug-windows-local",
            "inherits": "windows-vs2015",
            "displayName": "Windows Vendor Debug (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-debug-windows-local",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "vendor-release-windows-local",
            "inherits": "windows-vs2015",
            "displayName": "Windows Vendor Release (offline, no package manager)",
            "binaryDir": "${sourceDir}/build/vendor-release-windows-local",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "OFF",
                "ENABLE_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "windows-vs2019",
            "inherits": "windows-base",
            "displayName": "Windows VS2019 x64",
            "generator": "Visual Studio 16 2019",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "llvm-ninja-debug",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-release",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "vendor-debug-windows-local",
            "configurePreset": "vendor-debug-windows-local"
        },
        {
            "name": "vendor-release-windows-local",
            "configurePreset": "vendor-release-windows-local",
            "configuration": "Release"
        },
        {
            "name": "vendor-debug-mac-local",
            "configurePreset": "vendor-debug-mac-local"
        },
        {
            "name": "windows-vs2019",
            "configurePreset": "windows-vs2019",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2015",
            "configurePreset": "windows-vs2015",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "vendor-debug-mac-local",
            "inherits": "test-base",
            "configurePreset": "vendor-debug-mac-local"
        },
        {
            "name": "vendor-debug-windows-local",
            "inherits": "test-base",
            "configurePreset": "vendor-debug-windows-local",
            "configuration": "Debug"
        },
        {
            "name": "vendor-release-windows-local",
            "inherits": "test-base",
            "configurePreset": "vendor-release-windows-local",
            "configuration": "Release"
        }
    ]
}