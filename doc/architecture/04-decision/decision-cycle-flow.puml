@startuml decision-cycle-flow
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FFF7ED
  DiamondBorderColor #C2410C
}

start

:Core 构造 DecisionContext(track_snapshots);
:创建 TargetClassifierView;

if (track_snapshots 为空?) then (是)
  :写入 UNKNOWN 分类;
  :结束分类步骤;
else (否)
  :循环遍历每个 track snapshot;
  if (注入了 IFeatureRepository?) then (是)
    :构造 FeatureVector(speed, rcs, jamming);
    :QueryBestMatch;
    if (匹配结果通过阈值?) then (是)
      :采用仓储分类结果;
    else (否)
      :回退规则识别;
    endif
  else (否)
    :规则识别;
  endif
  :写入 TargetCategoryList;
  :更新 LpiSourceInfo;
endif

:创建 LpiControllerView;
if (has_recon_platform?) then (是)
  :追加 SET_LPI_POWER;
else (否)
  :LPI 不输出命令;
endif

:创建 EccmControllerView;
if (has_jamming_signal?) then (是)
  :追加 5 条 ECCM 指令;
else (否)
  :ECCM 不输出命令;
endif

:Core 统一提交 decision_commands;
stop
@enduml
