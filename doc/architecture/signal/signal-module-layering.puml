@startuml signal-module-layering
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName sans-serif
skinparam shadowing false

title Signal 层模块分层（位置唯一主路径 / Lifecycle 种子接管 / FallbackHistoryCache / Kalman / EKF / IMM）

package "编排层" {
  rectangle "RadarController\n跨层调度入口" as CTRL
  rectangle "SignalPipeline\nSignal 周期主编排器" as PIPELINE
  rectangle "Association seed bridge\nBuildAssociationSeeds()\n→ SetAssociationSeeds()" as SEED_BRIDGE
}

package "信号处理算法层" {
  rectangle "EnvironmentSampling / Echo / Detection\n回波与探测判决" as DETECT

  package "Association" {
    rectangle "DataAssociationEngine\n位置主路径 + FallbackHistoryCache 兼容缓存" as ASSOC_ENGINE
    rectangle "MahalanobisDistanceMetric\n对角简化马氏距离" as METRIC
    rectangle "FullMahalanobisDistanceMetric\n完整协方差马氏距离" as FULL_METRIC
    rectangle "CostThresholdGater\n波门裁剪" as GATER
    rectangle "DenseCostHypothesiser\n假设生成（支持逐轨迹 S）" as HYP
    rectangle "LapjvSolver\n最优指派" as SOLVER
    rectangle "Association-side Kalman\nPredictor / Updater\n（仅位置关联预测使用）" as ASSOC_KF
    rectangle "FallbackHistoryCache\n无 Lifecycle 场景兼容缓存" as FALLBACK_CACHE
  }

  package "Tracking Filter" {
    rectangle "TrackFilter\n标量特征预测/更新" as FILTER

    package "Kalman Family" {
      rectangle "KalmanPredictor\n3D CV 标准 Kalman" as KF_PRED
      rectangle "KalmanUpdater\nJoseph 形式" as KF_UPD
      rectangle "EkfPredictor\n扩展 Kalman 预测" as EKF_PRED
      rectangle "EkfUpdater\n扩展 Kalman 更新" as EKF_UPD
      rectangle "ImmFilter\n交互多模型 (Bar-Shalom)" as IMM
    }
  }

  rectangle "TrackMeasurement bridge\nGetLastTrackMeasurements()" as MEAS
}

package "生命周期域层" {
  rectangle "TrackLifecycleManager\n建轨/确认/丢失/回收\n+ Kalman / 每轨 IMM 状态估计集成" as LIFECYCLE
  rectangle "Stable Track Snapshot\n供决策层/分类使用" as SNAPSHOT
}

package "基础设施层" {
  rectangle "ITrackPool / BoostTrackPool\n对象池" as POOL
}

CTRL --> PIPELINE
CTRL --> SEED_BRIDGE
SEED_BRIDGE --> PIPELINE
SEED_BRIDGE --> LIFECYCLE
PIPELINE --> DETECT
PIPELINE --> ASSOC_ENGINE
PIPELINE --> FILTER
PIPELINE --> MEAS
PIPELINE ..> KF_PRED : 持有
PIPELINE ..> KF_UPD : 持有
MEAS --> LIFECYCLE
LIFECYCLE --> SNAPSHOT
LIFECYCLE --> POOL : 申请 / 归还
LIFECYCLE ..> KF_PRED : 可选注入
LIFECYCLE ..> KF_UPD : 可选注入

ASSOC_ENGINE --> METRIC
ASSOC_ENGINE --> FULL_METRIC
ASSOC_ENGINE --> GATER
ASSOC_ENGINE --> HYP
ASSOC_ENGINE --> SOLVER
ASSOC_ENGINE --> ASSOC_KF
ASSOC_ENGINE --> FALLBACK_CACHE
FILTER --> KF_PRED
FILTER --> KF_UPD

EKF_PRED --|> KF_PRED : 实现 IKalmanPredictor
EKF_UPD --|> KF_UPD : 实现 IKalmanUpdater
IMM --> KF_PRED : N 个 Predictor
IMM --> KF_UPD : N 个 Updater
LIFECYCLE ..> IMM : 按轨迹持有

note right of PIPELINE
  负责串接单周期执行顺序。
  默认走位置空间关联。
  导出 TrackMeasurement，并接收
  来自 Lifecycle 的外部关联 seeds。
  绑定 Lifecycle 时会自动关闭
  内部 fallback 兼容模式。
end note

note right of ASSOC_ENGINE
  默认走基于 position_x/y/z 的
  位置空间关联，并在内部计算
  逐轨迹新息协方差 S。

  外部 Lifecycle seeds 一旦接管，
  内部历史仅保留 fallback-only 兼容角色。
  当前已收敛为 FallbackHistoryCache 对象。
end note

note right of FALLBACK_CACHE
  仅在未接入 Lifecycle 种子时启用。
  承担 prior fallback 的最小兼容能力，
  不再扩张正式主路径状态所有权。
end note

note right of IMM
  Bar-Shalom 4 步算法：
  混合 → 预测 → 更新 → 组合。
  支持 KF + EKF 混合模型集。
  当前以每轨运行态形式挂接到 LifecycleManager。
end note

note right of LIFECYCLE
  唯一生命周期域服务。
  集成 Kalman 与每轨 IMM 状态估计逻辑。
  has_cartesian_position 为激活条件。
  同时导出 AssociationTrackSeed
  作为下一周期关联先验真理源。
  当前已补充周期摘要日志。
end note

note bottom of POOL
  对象池属于基础设施，
  不承载航迹业务语义。
end note

@enduml