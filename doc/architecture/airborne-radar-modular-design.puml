@startuml airborne-radar-modular-design
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName sans-serif

package "公共 API 层 (01-api)\n【Facade / PIMPL / Builder】" #LightBlue {
    class RadarSession {
        - impl_ : unique_ptr<Impl>
        + Step(input) : TrackOutputFrame
        + StepWithResult(input) : RadarCycleResult
    }

    class ConfigPresets << (F,#FF7700) Factory >> {
        + MakeDetectionMissionRadarSessionConfig()
        + MakeHighRobustnessSignalPipelineConfig()
    }

    class RadarSessionConfigBuilder << (B,#FF7700) Builder >> {
        + WithTransmitter...() / WithAntenna...()
        + WithTracking...() / WithLifecycle...()
        + Build() : RadarSessionConfig
    }

    class TargetFeatureBuilder << (B,#FF7700) Builder >> {
        + Position() / Velocity() / Rcs()
        + Build() : TargetFeature
    }

    class TrackOutputQueries {
        + CollectConfirmedTracks()
        + BuildTrackMapByExternalTargetId()
    }

    class RadarInputValidation {
        + ValidateRadarCycleInput()
        + HasValidationError()
    }
}

package "核心协调层 (02-core)\n【Mediator / 依赖注入】" #LightYellow {
    class RadarController {
        - impl_ : unique_ptr<Impl>
        + RunOnce()
        + RunCycles(n)
    }

    class MutableRadarContext {
        + BeginCycle(input)
        + GetTargetFeatures()
        + SubmitControlCommand(cmd)
    }

    class DataOutputManager {
        + BuildTrackOutputFrame()
        + BuildDecisionInputFrame()
    }

    interface IRadarContext << (I,orchid) >> {
        + GetTargetFeatures()
        + SubmitControlCommand(cmd)
    }

    interface IEventBus << (I,orchid) >> {
        + Subscribe<Event>() / Publish<Event>()
        + BeginCycle() / DispatchCurrentCycle()
    }

    class EventBus {
        即时同步分发
    }
    class CycleEventBus {
        双缓冲周期延迟
    }

    MutableRadarContext ..|> IRadarContext
    EventBus ..|> IEventBus
    CycleEventBus ..|> IEventBus
}

package "信号处理层 (03-signal)\n【Pipeline / Strategy】" #LightGreen {
    interface ISignalPipeline << (I,orchid) >> {
        + RunCycle(targets, env) : SignalCycleResult
        + SetControlProfile(profile)
    }

    class SignalPipeline {
        - impl_ : unique_ptr<Impl>
        + SetAssociationSeeds(seeds)
        + CreateAutoLifecycleManager()
    }

    class SignalDetector {
        回波功率 → SNR → Pd → 判决
    }
    class BeamControlResolver {
        波束宽度 / 指向 / 方向图增益
    }
    class DataAssociationEngine {
        波门 → 假设生成 → LAPJV
    }
    class TrackLifecycleManager {
        状态机 + Kalman/EKF/IMM
    }

    interface ITrackLifecycleManager << (I,orchid) >> {
        + Update(cycle, measurements)
        + BuildDecisionSnapshot()
        + BuildAssociationSeeds()
    }

    interface ITrackPool << (I,orchid) >> {
        + Acquire() / Release()
    }

    SignalPipeline ..|> ISignalPipeline
    SignalPipeline --> SignalDetector
    SignalPipeline --> BeamControlResolver
    SignalPipeline --> DataAssociationEngine

    TrackLifecycleManager ..|> ITrackLifecycleManager
    TrackLifecycleManager --> ITrackPool : 内存复用
}

package "决策层 (04-decision)\n【评估器管线 / Proposal 归约】" #LightCyan {
    interface ITacticalDecisionEngine << (I,orchid) >> {
        + Evaluate(input, state) : TacticalDecisionResult
    }

    class TacticalCoordinator {
        编排三个评估器
    }

    class ThreatAssessmentEvaluator {
        威胁识别 + 跨周期记忆
    }
    class EmissionControlEvaluator {
        LPI 控制建议
    }
    class SurvivabilityEvaluator {
        ECCM 组合策略建议
    }
    class ControlReducer {
        归约 + hold/cooldown + 冲突裁决
    }

    TacticalCoordinator ..|> ITacticalDecisionEngine
    TacticalCoordinator --> ThreatAssessmentEvaluator
    TacticalCoordinator --> EmissionControlEvaluator
    TacticalCoordinator --> SurvivabilityEvaluator

    ThreatAssessmentEvaluator -[hidden]right-> EmissionControlEvaluator
    EmissionControlEvaluator -[hidden]right-> SurvivabilityEvaluator
}

package "环境层 (05-environment)\n【基础设施 / Repository】" #LightGray {
    interface IEnvironmentService << (I,orchid) >> {
        + SampleEnvironment() : EnvironmentSnapshot
    }

    class EnvironmentService {
        传播损耗 / 杂波 / 干扰事实
    }
    class SceneManager {
        场景实体与干扰源管理
    }

    interface IFeatureRepository << (I,orchid) >> {
        + Match(feature) : MatchResult
    }

    EnvironmentService ..|> IEnvironmentService
    EnvironmentService --> SceneManager
}

' ==========================================
' 层间关系
' ==========================================

RadarSession --> RadarController : 内部持有

RadarController --> IRadarContext : 周期上下文
RadarController --> ISignalPipeline : 驱动信号处理
RadarController --> ITacticalDecisionEngine : 驱动决策
RadarController --> IEnvironmentService : 采样环境
RadarController --> IEventBus : 事件编排
RadarController --> DataOutputManager : 输出装配

RadarController --> ITrackLifecycleManager : 种子回灌 / 快照消费

ISignalPipeline --> IEnvironmentService : 查询环境快照

ThreatAssessmentEvaluator --> IFeatureRepository : 特征匹配

note top of RadarController
  **Mediator 模式**
  唯一协调点：编排 Signal → Decision → Environment
  不承载业务逻辑，不持有可变共享状态
end note

note right of ISignalPipeline
  **公共边界极简**
  对外仅 3 个公共头：
  ISignalPipeline.h
  SignalPipelineTypes.h
  DetectionTypes.h
end note

note bottom of ControlReducer
  **Proposal 归约**
  按优先级排序 → 去重 → 域级 hold/cooldown
  → LPI/ECCM 冲突裁决 → RadarControlProfile
end note

@enduml
