* text=auto

# 仓库元文件统一 LF
.gitattributes text eol=lf
.gitignore text eol=lf
# 无扩展名 hook 脚本：须强制 LF，否则 Windows 检出成 CRLF 会在 WSL 下弄坏 shebang
.githooks/** text eol=lf

# 源码/构建/脚本统一 LF
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf

*.cmake text eol=lf
*.cmake.in text eol=lf
CMakeLists.txt text eol=lf

*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.puml text eol=lf
*.resolved text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.lib binary
